APP_NAME=MathMate Exam System
APP_ENV=development
API_PREFIX=/api

JSON_DATABASE_PATH=db/exam_data.json

LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=30

OCR_API_KEY=
OCR_BASE_URL=

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

AUTH_SECRET_PATH=/opt/mathmate/auth_secret.txt
AUTH_TOKEN_MAX_AGE_SECONDS=604800
CORS_ORIGINS=https://mathmate.top,https://www.mathmate.top
